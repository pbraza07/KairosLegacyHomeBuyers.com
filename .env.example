# Copy to .env for local use. Never commit .env. No VITE_ variables contain secrets.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# Use your managed PostgreSQL connection string; use internal URL on Render.
DATABASE_URL=postgresql://postgres:local-development-only@localhost:5432/kairos
# true for external TLS DB connections, false for local Docker or Render private networking.
# TLS certificate verification is never disabled.
DATABASE_SSL=false
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Local direct access: 0. Render's single reverse proxy: 1.
TRUST_PROXY_HOPS=0
# Set privately only to create/reset an admin, then remove ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Server-only notifications. Gmail API uses HTTPS and works on Render Free;
# it does not use Gmail SMTP or an App Password. Set EMAIL_PROVIDER=gmail_api.
EMAIL_PROVIDER=gmail_api
# Google Cloud OAuth client credentials for the Gmail account that sends mail.
# The refresh token must include the https://www.googleapis.com/auth/gmail.send
# scope. Keep all four values private and server-side.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_API_USER=kairoslegacyhomes@gmail.com
# Destination inbox for new inquiry alerts.
NOTIFICATION_EMAIL=kairoslegacyhomes@gmail.com
# Legacy Gmail SMTP fallback for migrations only. It requires a paid Render
# plan because the free plan blocks outbound SMTP ports.
GMAIL_SMTP_USER=kairoslegacyhomes@gmail.com
GMAIL_SMTP_APP_PASSWORD=
# Optional Cloudflare Turnstile (configure BOTH keys and hostname together).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional synthetic browser QA only. Keep false; NEVER use this on a public deployment.
KAIROS_TEST_PREVIEW=false

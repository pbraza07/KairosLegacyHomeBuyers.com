{
  "name": "kairos-legacy-homes",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.16.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "migrate": "node --import tsx scripts/migrate.ts",
    "admin:create": "node --import tsx scripts/admin.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
